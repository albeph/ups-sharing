# =====================================================================
# NUT SERVER ENVIRONMENT CONFIGURATION TEMPLATE (configs/.env.example)
# =====================================================================
# Copy to configs/.env or run 'sudo ./utils/setup.sh' to generate.
# NOTE: Passwords are NOT stored in this file.
# They are managed via Docker Secrets in configs/secrets/ (RAM-mounted).

IMAGE_NAME=nut-server:local
CONTAINER_NAME=nut-server
# Container timezone (e.g. UTC, America/New_York, Europe/London)
TZ=UTC

UPS_NAME=ups
ALERT_LANG=en
UPS_FRIENDLY_NAME="Home UPS"
# Optional fallback if your UPS does not report ups.realpower.nominal via USB
# UPS_NOMINAL_WATTS=
BATTERY_CHARGE_LOW=30
BATTERY_RUNTIME_LOW=300
UPS_OFFDELAY=60
UPS_ONDELAY=70

# Post-FSD Recovery Notification Tuning (optional, defaults shown)
# FSD_RECOVERY_STABLE_SEC=15
# FSD_RECOVERY_RETRY_INITIAL=15
# FSD_RECOVERY_RETRY_MAX=60
# FSD_RECOVERY_MAX_ATTEMPTS=1440

# NUT Role-Based Client Users
API_USER=upsmon
SECONDARY_USER=upsmon_client

# SMTP Notification Settings
SMTP_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=on
SMTP_STARTTLS=on
SMTP_AUTH=on
SMTP_USER=your_email@example.com
NOTIFICATION_EMAIL=recipient@example.com
